@article{wang2026angle,
  bibtex_show={true},
  abbr={arXiv},
  title={Relative Wasserstein Angle and the Problem of the $W_2$-Nearest Gaussian Distribution},
  author={Wang, Binshuai and Wei, Peng},
  journal={arXiv preprint},
  year={2026},
  abstract={In this paper, we investigate a basic question: to what extent can an empirical distribution be regarded as Gaussian from the perspective of optimal transport. To address this problem, we introduce two novel geometric notions—the relative Wasserstein angle (the $RW_2$ angle) and the associated orthogonal projection distance. By proving that the filling cone generated by any two rays has zero sectional curvature, we establish that both quantities are well defined and can be used to quantify the degree of non-Gaussianity of an empirical distribution. Beyond the Gaussian family, we further demonstrate that these quantities can be used to quantify deviations for other distribution families, including uniform, Laplace, and logistic distributions. We also show that, for non-Gaussian distributions, the moment-matching Gaussian can *not* be the nearest Gaussian approximation under the optimal transport metric. In the one-dimensional setting, we derive closed-form solutions for the proposed quantities. For high-dimensional settings, we develop an efficient algorithm for computing the nearest Gaussian approximation, based on a dual formulation combined with manifold optimization techniques. Finally, we present two experiments to validate our theoretical results. The first experiment demonstrates that the $RW_2$ angle is more robust than the Wasserstein distance for measuring differences between distributions and further confirms that the moment-matching Gaussian is *not* the nearest Gaussian approximation. The second experiment investigates the Gaussianity of feature distributions from commonly used datasets in the evaluation of Fr\'echet Inception Distance (FID) scores. To the best of our knowledge, this is the first work to rigorously establish that the $RW_2$ angle and orthogonal projection distance are well-defined and can serve as principled measures of deviations for the Gaussian family and other families, including uniform, Laplace, and logistic distributions.},
  pdf={Wang26rw_angle.pdf},

  selected={false}
}

@article{wang2026rtiwd,
  bibtex_show={true},
  abbr={TMLR},
  title={Relative Translation Invariant Wasserstein Distance},
  author={Wang, Binshuai and Di, Qiwei and Yin, Ming and Wang, Mengdi and Gu, Quanquan and Wei, Peng},
  journal={Transactions on Machine Learning Research},
  year={2026},
  issn={2835-8856},
  abstract={Motivated by the Bures distance, we introduce a new family of distances, \emph{relative translation invariant Wasserstein distances}, denoted by $RW_p$, as an extension of the classical Wasserstein distances $W_p$ for $p \in [1, +\infty)$. We establish that $RW_p$ defines a valid metric and demonstrate that this type of metric is more intrinsic than the classical Wasserstein distance. A bi-level algorithm is designed to compute the general $RW_p$ distance between arbitrary discrete distributions. Moreover, when $p = 2$, we show that the optimal coupling matrix is invariant under distributional translation in the discrete setting, and we further propose two algorithms, the $\mathrm{RW}_2$-LP algorithm and $\mathrm{RW}_2$-Sinkhorn algorithm, to improve the numerical stability of computing $W_2$ distance and the optimal coupling matrix solutions. Finally, we conduct three experiments to validate our theoretical results and algorithms. The first two experiments report that the $\mathrm{RW}_2$-LP algorithm and $\mathrm{RW}_2$-Sinkhorn algorithm, both with and without normalization, can significantly reduce the numerical errors compared to standard algorithms. The third experiment shows that $RW_p$ algorithms are computationally scalable and applicable to the retrieval of similar thunderstorm patterns in practical applications.},
  pdf={Wang26rwp.pdf},
  code={https://github.com/DRKWang/rw_metric},
  selected={true}
}

