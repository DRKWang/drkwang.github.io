+.sidebar-head {
+  display: flex;
+  margin-bottom: 22px;
+}
+
+.sidebar-toggle {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  width: 38px;
+  height: 38px;
+  padding: 0;
+  background: none;
+  border: 1px solid #b9d4ec;
+  border-radius: 4px;
+  color: #005eb8;
+  cursor: pointer;
+  transition: color 0.15s ease, background 0.15s ease;
+}
+
+.sidebar-toggle:hover {
+  background: #eaf3fb;
+}
+
+.sidebar-toggle[aria-expanded="true"] {
+  color: #04305c;
+}
+
+.sidebar-toggle svg {
+  width: 17px;
+  height: 17px;
+  display: block;
+}
+
+.sidebar,
+.sidebar nav {
+  transition: width 0.2s ease, padding 0.2s ease;
+}
+
+/* Collapsed state: sidebar narrows to just the toggle button, links hide */
+html.sidebar-collapsed .sidebar {
+  width: 62px;
+  padding: 30px 12px;
+}
+
+html.sidebar-collapsed .sidebar-head {
+  margin-bottom: 0;
+}
+
+html.sidebar-collapsed .sidebar nav {
+  display: none;
+}
+
